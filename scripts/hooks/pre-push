#!/usr/bin/env bash
# ============================================================
# HMIS pre-push hook: block a push whose outgoing commits ADD risky files
# (same rules as the CI changeset guard; see .github/changeset-guard-patterns.txt).
# Installed by scripts/install-dev-hooks.sh.
# Bypass for one push only, after checking every file it names:
#   HMIS_ALLOW_RISKY_PUSH=1 git push ...
# ============================================================
REPO_ROOT="$(git rev-parse --show-toplevel)"
GUARD="$REPO_ROOT/scripts/changeset-guard.sh"
[ -f "$GUARD" ] || exit 0   # branch predates the guard

if [ "${HMIS_ALLOW_RISKY_PUSH:-}" = "1" ]; then
  echo "pre-push: HMIS_ALLOW_RISKY_PUSH=1 set, changeset guard skipped."
  exit 0
fi

STATUS=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ -n "${local_sha:-}" ] || continue
  case "$local_sha" in *[!0]*) ;; *) continue ;; esac   # branch deletion
  # Outgoing = commits not already on any remote-tracking branch.
  set -- "$local_sha" --not --remotes
  case "$remote_sha" in
    *[!0]*) git cat-file -e "$remote_sha^{commit}" 2>/dev/null && set -- "$@" "$remote_sha" ;;
  esac
  if ! bash "$GUARD" "$@"; then
    STATUS=1
  fi
done

if [ "$STATUS" -ne 0 ]; then
  echo ""
  echo "pre-push: push blocked. To push anyway (only if every file above is safe"
  echo "to publish), run: HMIS_ALLOW_RISKY_PUSH=1 git push ..."
fi
exit "$STATUS"
