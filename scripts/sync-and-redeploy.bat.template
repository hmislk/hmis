@echo off
REM Generated by scripts\generate-sync-redeploy-script.bat - safe to re-generate, do not hand-edit.
REM Reads all machine-specific values from %USERPROFILE%\hmis-sync-redeploy.conf.bat
REM so this template itself never needs per-machine substitution.
setlocal enabledelayedexpansion

set "CONFIG_FILE=%USERPROFILE%\hmis-sync-redeploy.conf.bat"
if not exist "%CONFIG_FILE%" (
    echo ERROR: %CONFIG_FILE% not found. Re-run scripts\generate-sync-redeploy-script.bat.
    exit /b 1
)
call "%CONFIG_FILE%"

set "PERSISTENCE_FILE=%REPO_ROOT%\src\main\resources\META-INF\persistence.xml"
cd /d "%REPO_ROOT%" || exit /b 1
echo === Repo: %REPO_ROOT% ===

if not "%JAVA_HOME_DETECTED%"=="" (
    set "JAVA_HOME=%JAVA_HOME_DETECTED%"
    set "PATH=%JAVA_HOME%\bin;%PATH%"
)

REM 1. Stash a local persistence.xml edit separately, so it never lands in a commit.
set "STASHED_PERSISTENCE=0"
git diff --quiet -- "%PERSISTENCE_FILE%"
if not "%errorlevel%"=="0" (
    echo Stashing local persistence.xml edit...
    git stash push -m "sync-and-redeploy: local JNDI" -- "%PERSISTENCE_FILE%"
    set "STASHED_PERSISTENCE=1"
)

REM 2. Commit anything else uncommitted.
set "HAS_CHANGES="
for /f "delims=" %%S in ('git status --porcelain') do set "HAS_CHANGES=1"
if defined HAS_CHANGES (
    echo Committing other uncommitted changes...
    git add -A
    git commit -m "WIP: auto-commit before sync-and-redeploy"
)

REM 3. Fetch and merge development. Stop on conflict - no auto-resolution.
echo Fetching origin/development...
git fetch origin development
echo Merging origin/development...
git merge origin/development --no-edit
if not "%errorlevel%"=="0" (
    echo.
    echo ERROR: merge conflict. Resolve manually, then re-run this script.
    echo Repository left mid-merge intentionally - no automatic conflict resolution.
    exit /b 1
)

REM 4. Restore local JNDI.
if "%STASHED_PERSISTENCE%"=="1" (
    echo Restoring stashed persistence.xml edit...
    git stash pop
) else if exist "%REPO_ROOT%\.jndi-backup-main" if exist "%REPO_ROOT%\.jndi-backup-audit" (
    echo Restoring local JNDI via restore-local-jndi.sh...
    bash "%REPO_ROOT%\scripts\restore-local-jndi.sh"
) else (
    echo Setting local JNDI from generator config...
    powershell -NoProfile -Command "(Get-Content -Raw '%PERSISTENCE_FILE%') -replace [regex]::Escape('${JDBC_DATASOURCE}'), '%MAIN_JNDI%' -replace [regex]::Escape('${JDBC_AUDIT_DATASOURCE}'), '%AUDIT_JNDI%' | Set-Content '%PERSISTENCE_FILE%'"
)

REM 5. Build.
set "MVN_CMD=mvn"
if exist "%REPO_ROOT%\detect-maven.bat" set "MVN_CMD=%REPO_ROOT%\detect-maven.bat"
echo Building with %MVN_CMD% ...
call "%MVN_CMD%" clean package -DskipTests

REM 6. Verify the WAR, rebuild once if it looks stale/empty.
call :find_war
call :check_war_size
if not "%WAR_OK%"=="1" (
    echo WAR missing or suspiciously small, rebuilding once...
    call "%MVN_CMD%" clean package -DskipTests
    call :find_war
    call :check_war_size
    if not "%WAR_OK%"=="1" (
        echo ERROR: WAR still missing/too small after rebuild. Aborting deploy.
        exit /b 1
    )
)
echo WAR ready: %WAR_FILE%

REM 7. Deploy with the discovered name/contextroot - never derived from the WAR filename.
set "ASADMIN=%PAYARA_HOME%\bin\asadmin.bat"
echo Deploying as name=%APP_NAME% contextroot=%CONTEXT_ROOT% on port %ADMIN_PORT% ...
call "%ASADMIN%" --port %ADMIN_PORT% deploy --force=true --name %APP_NAME% --contextroot %CONTEXT_ROOT% "%WAR_FILE%"

REM 8. Report success/failure from server.log.
set "SERVER_LOG=%PAYARA_HOME%\glassfish\domains\%DOMAIN_NAME%\logs\server.log"
echo Recent server.log entries:
powershell -NoProfile -Command "Get-Content -Tail 30 '%SERVER_LOG%' | Select-String -Pattern 'deployed','deploy.*fail','exception'"
echo Done. Check http://localhost:%HTTP_PORT%/%CONTEXT_ROOT%/ if the app didn't report success above.
exit /b 0

:find_war
set "WAR_FILE="
for /f "delims=" %%W in ('dir /b /o-d "%REPO_ROOT%\target\*.war" 2^>nul') do if not defined WAR_FILE set "WAR_FILE=%REPO_ROOT%\target\%%W"
goto :eof

:check_war_size
set "WAR_OK=0"
if defined WAR_FILE for %%Z in ("%WAR_FILE%") do if %%~zZ GTR 1048576 set "WAR_OK=1"
goto :eof
